# Radar Leilão — variáveis de ambiente (exemplo)
# Copie para .env:  cp .env.example .env
# IMPORTANTE: Docker Compose lê o arquivo .env, NÃO este .env.example. Nunca coloque uma chave real neste arquivo.
# O .env NÃO é versionado (ver .gitignore). Use apenas valores locais.

# --- PostgreSQL (usado pelo Docker Compose para criar o banco automaticamente) ---
POSTGRES_DB=radar_leilao
POSTGRES_USER=radar
POSTGRES_PASSWORD=radar_local
POSTGRES_PORT=5432

# --- Backend (FastAPI) ---
# Em execução local sem Docker, aponte para localhost.
# No Docker Compose, o backend usa automaticamente o host `postgres` (não precisa mexer aqui).
DATABASE_URL=postgresql+psycopg://radar:radar_local@localhost:5432/radar_leilao
BACKEND_PORT=8000
STORAGE_DIR=storage/documents

# --- Frontend (React + Vite) ---
FRONTEND_PORT=5173
# URL da API acessada pelo navegador (embutida no build do frontend).
VITE_API_URL=http://localhost:8000

# --- LLM Gateway (OPCIONAL) ---
# O projeto SOBE SEM chave. Deixe OPENAI_API_KEY vazio para rodar sem LLM.
# Preencha apenas se quiser habilitar análises com LLM real.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=

# --- Judicial API (módulo independente, serviço `judicial_api`) ---
# Porta exposta do serviço Judicial API.
JUDICIAL_PORT=8010
# Ambiente: "local" mantém a autenticação opcional. Em produção use outro valor
# (ex.: "production") — aí JUDICIAL_API_KEYS passa a ser OBRIGATÓRIO (falha fechada).
JUDICIAL_ENVIRONMENT=local
# Chaves de CONSUMIDOR da Judicial API (nunca versione uma chave real).
# Formato: "chave" (acesso total) ou "chave:search|read", separadas por vírgula.
JUDICIAL_API_KEYS=
# Credencial PÚBLICA do DataJud/CNJ (nunca versione um valor real). Sem ela, a
# consulta real falha de forma controlada; a API sobe normalmente.
JUDICIAL_DATAJUD_API_KEY=

# --- Integração Radar -> Judicial API (consumida pelo backend do Radar) ---
# No Docker Compose o backend fala com o serviço judicial pelo nome `judicial_api`.
JUDICIAL_API_BASE_URL=http://judicial_api:8010
# Chave de consumidor que o backend envia à Judicial API (deve constar em JUDICIAL_API_KEYS).
JUDICIAL_API_CONSUMER_KEY=
JUDICIAL_API_TIMEOUT_SECONDS=30
