# Frontend do Radar Leilão — imagem de PRODUÇÃO.
# Multi-stage: build estático com Node, servido por Nginx (não usa vite preview).
# ---- Estágio 1: build ----
FROM node:22-slim AS build
WORKDIR /app

# VITE_API_URL é embutido no bundle em tempo de build (nunca secrets no front).
ARG VITE_API_URL=/api
ENV VITE_API_URL=${VITE_API_URL}

COPY frontend/package.json frontend/package-lock.json* /app/
RUN npm install
COPY frontend /app
RUN npm run build

# ---- Estágio 2: runtime nginx (não-root já é o default da imagem nginx) ----
FROM nginx:1.27-alpine AS runtime
# Config do site (porta 8080, SPA, cache de assets).
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
# Remove a config default que escuta na 80 para evitar conflito.
RUN rm -f /etc/nginx/conf.d/default.conf.bak 2>/dev/null || true
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s --retries=5 CMD wget -qO- http://localhost:8080/healthz || exit 1
CMD ["nginx", "-g", "daemon off;"]
