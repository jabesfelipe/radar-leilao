# Radar Leilão — variáveis de PRODUÇÃO (exemplo). Copie para .env.prod e preencha.
#   cp .env.prod.example .env.prod   (e NUNCA versione o .env.prod)
# Docker Compose de produção: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# NUNCA coloque valores reais de segredo neste arquivo de exemplo.

# --- PostgreSQL (NÃO exposto à internet no compose de produção) ---
POSTGRES_DB=radar_leilao
POSTGRES_USER=radar
# Gere uma senha forte (ex.: openssl rand -base64 24). OBRIGATÓRIA em produção.
POSTGRES_PASSWORD=

# --- Backend ---
LOG_LEVEL=INFO
# Nº de workers do uvicorn (ajuste à CPU da VPS; regra inicial: ~2 x vCPU).
UVICORN_WORKERS=2
# Migração controlada: mantenha false. Aplique migrations pelo serviço `migrate`.
RUN_MIGRATIONS_ON_START=false
# OBRIGATÓRIO: segredo de assinatura do JWT. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480
# CORS: domínio público do frontend (sem barra final). Ex.: https://app.exemplo.com
CORS_ALLOW_ORIGINS=https://app.exemplo.com

# --- Storage de documentos ---
# local (volume) ou s3/minio (recomendado em produção p/ desacoplar PDFs do banco).
STORAGE_BACKEND=local
# Se STORAGE_BACKEND=s3|minio, preencha abaixo (sem versionar segredos):
STORAGE_S3_BUCKET=
STORAGE_S3_ENDPOINT_URL=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=

# --- LLM (opcional; sem chave o RAG degrada para busca textual) ---
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# --- Bootstrap opcional do 1º administrador (idempotente) ---
AUTH_BOOTSTRAP_ADMIN_EMAIL=
AUTH_BOOTSTRAP_ADMIN_PASSWORD=

# --- Frontend ---
# Em produção, o frontend chama a API pelo mesmo domínio atrás do proxy (/api).
VITE_API_URL=/api
