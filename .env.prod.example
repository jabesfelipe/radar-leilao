# Radar Leilão — variáveis da VPS (homologação). Fica SÓ na VPS, como .env.prod (chmod 600).
# Normalmente é gerado por scripts/prod/bootstrap-vps.sh (segredos aleatórios); este arquivo
# é o modelo. NUNCA versione o .env.prod nem coloque valores reais aqui.
# Deploy: automático por tag (GitHub Actions) — ver docs/GITHUB-ACTIONS-DEPLOY.md.
# Comandos manuais: scripts/prod/compose.sh ps | logs | ... (carrega este arquivo + .release.env)

# --- PostgreSQL (não exposto: só na rede interna do compose) ---
POSTGRES_DB=radar_leilao
POSTGRES_USER=radar
# OBRIGATÓRIA. Gere com: openssl rand -base64 24
POSTGRES_PASSWORD=

# --- Backend ---
LOG_LEVEL=INFO
# 2 workers (Contabo Cloud VPS 6: 6 vCPU / ~11 GiB). Em VPS de 4 GB use 1.
UVICORN_WORKERS=2
# Mantenha false: migrations só pelo serviço `migrate` (o backend recusa subir com schema incompatível).
RUN_MIGRATIONS_ON_START=false
# OBRIGATÓRIO. Gere com: openssl rand -base64 48
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Origem que o navegador usa (frontend e API estão no mesmo host atrás do proxy).
# Modo A: http://IP_DA_VPS   |   Modo B: https://radar-vps.<tailnet>.ts.net
CORS_ALLOW_ORIGINS=http://IP_DA_VPS

# --- Primeiro administrador (idempotente; APAGUE a senha e rode `up -d backend` após o 1º login) ---
AUTH_BOOTSTRAP_ADMIN_EMAIL=
AUTH_BOOTSTRAP_ADMIN_PASSWORD=

# --- Portão de acesso do proxy ---
# OBRIGATÓRIA: 48 caracteres hexadecimais. Gere com: openssl rand -hex 24
# Acesso inicial em cada dispositivo: http://IP_DA_VPS/acesso?k=<GATE_KEY>
GATE_KEY=

# --- Modo de acesso ---
# MODO A (ATUAL — homologação TEMPORÁRIA pelo IP público, HTTP sem TLS):
#   o proxy escuta em todas as interfaces na porta 80. NÃO use dados sensíveis.
#   O Docker publica a porta por conta própria (independe do UFW).
PROXY_BIND=0.0.0.0
PROXY_PORT=80
ALLOW_PUBLIC_HTTP=1
# MODO B (futuro/opcional, rede privada Tailscale + HTTPS *.ts.net) — ver HOMOLOGATION-GUIDE §3:
#   PROXY_BIND=127.0.0.1
#   PROXY_PORT=8080
#   ALLOW_PUBLIC_HTTP=0

# --- Storage de documentos: local (volume radar-prod_backend_storage) ---
STORAGE_BACKEND=local
# (Futuro) s3/minio — deixe vazio nesta fase.
STORAGE_S3_BUCKET=
STORAGE_S3_ENDPOINT_URL=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=

# --- Processamento ---
# OCR consome muita RAM/CPU: mantenha desligado até decidir usar (documentos escaneados).
OCR_ENABLED=false
WORKER_INTERVAL_SECONDS=30
WORKER_BATCH_LIMIT=5
# Tentativas de embedding por documento antes de sair da fila (inclui tentativas interrompidas por crash)
# e prazo (s) após o qual uma tentativa sem conclusão é considerada interrompida.
# WORKER_MAX_ATTEMPTS=5
# WORKER_LEASE_SECONDS=600
#   Regra: >= lotes x ((1 + LLM_MAX_RETRIES) x LLM_TIMEOUT_SECONDS + 10) + 60, com lotes = ceil(chunks / 1000)
#   (ver docs/03-architecture/security.md §7). 600 cobre ~2000 chunks com os padrões de timeout/retry.

# --- LLM (opcional; sem chave o RAG funciona por busca textual e embeddings ficam pendentes) ---
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# Timeout (s) e retries por chamada ao provider. Mantenha (1 + retries) x timeout abaixo do
# proxy_read_timeout do nginx (300 s) para uma chamada isolada.
# LLM_TIMEOUT_SECONDS=90
# LLM_MAX_RETRIES=1

# --- Privacidade, custo e HTTPS (ver docs/06-quality/homologacao-v1.0.2/PLANO-ATIVACAO-OPENAI.md) ---
# Mascara CPF/RG/e-mail/telefone/dados bancários e pseudonimiza partes (pessoa física) antes de enviar à OpenAI.
# LLM_REDACT_PII=true
# Teto de tokens de SAÍDA por chamada (vazio = padrão do modelo). 1500 validado na homologação v1.0.4.
LLM_MAX_OUTPUT_TOKENS=1500
# Orçamento mensal (USD) das chamadas registradas (chat, extração e embeddings); atingido => nenhuma chamada.
# NÃO substitui o limite de gasto no painel da OpenAI (obrigatório). Valor da homologação; ajuste conscientemente.
LLM_BUDGET_USD_MONTH=0.50
# Teto de UMA análise (soma dos agentes); os agentes restantes não rodam ao atingi-lo (pode exceder em no máximo
# uma chamada, pois é verificado antes de cada agente). Uma análise do caso-01 custou ~US$ 0,006.
LLM_BUDGET_USD_PER_ANALYSIS=0.10
# Falha segura (v1.0.4): true => sem os dois limites acima a IA não é chamada. Mantenha true em homologação/produção.
LLM_REQUIRE_BUDGET=true
# EMBEDDING_PRICE_PER_1M_USD=0.02   # só para estimativa em log; confirmar na página de preços
# OCR_MAX_PAGES=60                  # páginas lidas por PDF quando OCR_ENABLED=true
# Recusa (426) requisições de API sem HTTPS. LIGUE antes de enviar documento real ou ativar a OpenAI.
# REQUIRE_HTTPS=false

# --- Proteção contra abuso / consumo indevido (valores padrão, por usuário e por processo) ---
# UPLOAD_MAX_MB=30
# RATE_LIMIT_CRITICAL_PER_MINUTE=10
# RATE_LIMIT_UPLOAD_PER_MINUTE=30
# RATE_LIMIT_SEARCH_PER_MINUTE=30
# MAX_CONCURRENT_CRITICAL_PER_USER=2

# --- Backup ---
BACKUP_DEST=/opt/radar-backups
RETENTION_DAYS=14
