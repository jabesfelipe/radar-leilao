# Radar Leilão — variáveis da VPS (homologação). Copie para .env.prod e preencha.
#   cp .env.prod.example .env.prod && chmod 600 .env.prod   (NUNCA versione o .env.prod)
# Subir: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# NUNCA coloque valores reais neste arquivo de exemplo.

# --- PostgreSQL (não exposto: só na rede interna do compose) ---
POSTGRES_DB=radar_leilao
POSTGRES_USER=radar
# OBRIGATÓRIA. Gere com: openssl rand -base64 24
POSTGRES_PASSWORD=

# --- Backend ---
LOG_LEVEL=INFO
# 1 worker cabe folgado em 4 GB. Suba para 2 só se a VPS tiver 8 GB.
UVICORN_WORKERS=1
# Mantenha false: migrations só pelo serviço `migrate` (o backend recusa subir com schema incompatível).
RUN_MIGRATIONS_ON_START=false
# OBRIGATÓRIO. Gere com: openssl rand -base64 48
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Origem que o navegador usa (frontend e API estão no mesmo host atrás do proxy).
# Modo A: http://IP_DA_VPS   |   Modo B: https://radar-vps.<tailnet>.ts.net
CORS_ALLOW_ORIGINS=http://IP_DA_VPS

# --- Primeiro administrador (idempotente; APAGUE a senha e rode `up -d backend` após o 1º login) ---
AUTH_BOOTSTRAP_ADMIN_EMAIL=
AUTH_BOOTSTRAP_ADMIN_PASSWORD=

# --- Portão de acesso do proxy ---
# OBRIGATÓRIA: 48 caracteres hexadecimais. Gere com: openssl rand -hex 24
# Acesso inicial em cada dispositivo: http://IP_DA_VPS/acesso?k=<GATE_KEY>
GATE_KEY=

# --- Modo de acesso ---
# MODO A (ATUAL — homologação TEMPORÁRIA pelo IP público, HTTP sem TLS):
#   o proxy escuta em todas as interfaces na porta 80. NÃO use dados sensíveis.
#   O Docker publica a porta por conta própria (independe do UFW).
PROXY_BIND=0.0.0.0
PROXY_PORT=80
ALLOW_PUBLIC_HTTP=1
# MODO B (futuro/opcional, rede privada Tailscale + HTTPS *.ts.net) — ver HOMOLOGATION-GUIDE §3:
#   PROXY_BIND=127.0.0.1
#   PROXY_PORT=8080
#   ALLOW_PUBLIC_HTTP=0

# --- Storage de documentos: local (volume radar-prod_backend_storage) ---
STORAGE_BACKEND=local
# (Futuro) s3/minio — deixe vazio nesta fase.
STORAGE_S3_BUCKET=
STORAGE_S3_ENDPOINT_URL=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=

# --- Processamento ---
# OCR consome muita RAM/CPU; em 4 GB habilite só se precisar (documentos escaneados).
OCR_ENABLED=false
WORKER_INTERVAL_SECONDS=30
WORKER_BATCH_LIMIT=5

# --- LLM (opcional; sem chave o RAG funciona por busca textual e embeddings ficam pendentes) ---
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# --- Backup ---
BACKUP_DEST=/opt/radar-backups
RETENTION_DAYS=14
